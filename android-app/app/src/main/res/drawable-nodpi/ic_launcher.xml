<?xml version="1.0" encoding="utf-8"?>
<!--
  ic_launcher and lsfg_app_icon were byte-identical 1254x1254 PNGs (same icon,
  referenced under two resource names — one from AndroidManifest as the app
  icon, one from in-app UI code). Shipping both duplicated ~88KB in the APK
  for no reason. This alias makes ic_launcher point at the single real bitmap
  (now downscaled to 512x512, still far above any on-screen usage) instead of
  carrying a second copy.
-->
<bitmap xmlns:android="http://schemas.android.com/apk/res/android"
    android:src="@drawable/lsfg_app_icon" />
